int calcularCalidadAire() {
    int calidad = 100;
    if (datosClima.velocidad_viento > 3.0) calidad += 10;
    if (datosClima.condicion.indexOf("lluvia") >= 0 ||
        datosClima.condicion.indexOf("rain")   >= 0) calidad += 15;
    if (datosClima.presion > 1020 && datosClima.velocidad_viento < 1.0) calidad -= 20;
    if (datosClima.temperatura > 30 && datosClima.humedad > 80) calidad -= 15;
    return constrain(calidad, 0, 100);
}


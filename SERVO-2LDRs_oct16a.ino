void leerSensoresLDR() {
    valorLdrEste  = analogRead(LDR_ESTE);
    valorLdrEsteBIS = valorLdrEste;
    valorLdrOeste = analogRead(LDR_OESTE);
    valorLdrOesteBIS = valorLdrOeste;
    diferenciaLdr = valorLdrEste - valorLdrOeste;
}

// =============================================
// LECTURA CONTINUA SENSORES INA219 (SIN RELÃS)
// =============================================
void leerSensoresINA219() {
    // Arrays temporales para no tocar los "Bis" hasta terminar
    float v[4], c[4], p[4];

    for (int i = 0; i < 4; i++) {
        float vshunt = sensoresINA219[i]->getShuntVoltage_mV();
        float bus    = sensoresINA219[i]->getBusVoltage_V();

        v[i] = bus + (vshunt / 1000.0);
        c[i] = sensoresINA219[i]->getCurrent_mA() / 1000.0;

        // ValidaciÃ³n bÃ¡sica (rangos razonables)
        if (v[i] < 0 || v[i] > 30) v[i] = 0;
        if (c[i] < 0 || c[i] > 10) c[i] = 0;

        p[i] = v[i] * c[i];
    }

    // Actualizar variables Cloud
    voltaje_1 = v[0];  voltaje_2 = v[1];  voltaje_3 = v[2];  voltaje_4 = v[3];
    corriente_1 = c[0]; corriente_2 = c[1]; corriente_3 = c[2]; corriente_4 = c[3];
    potencia_1 = p[0];  potencia_2 = p[1];  potencia_3 = p[2];  potencia_4 = p[3];

    // Actualizar variables "Bis" para Sheets
    voltaje_1Bis = voltaje_1;  corriente_1Bis = corriente_1;  potencia_1Bis = potencia_1;
    voltaje_2Bis = voltaje_2;  corriente_2Bis = corriente_2;  potencia_2Bis = potencia_2;
    voltaje_3Bis = voltaje_3;  corriente_3Bis = corriente_3;  potencia_3Bis = potencia_3;
    voltaje_4Bis = voltaje_4;  corriente_4Bis = corriente_4;  potencia_4Bis = potencia_4;
}


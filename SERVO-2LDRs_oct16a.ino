// =============================================
// MODO PI
// =============================================
void seguirModoPI() {
    double error = 0.0 - diferenciaLdr;
    double salidaPI = controladorPI.calcularSalida(error);

    int movimiento = (int)constrain(salidaPI, -MOV_MAX_POR_CICLO, MOV_MAX_POR_CICLO);
    int nuevaPosicion = constrain(servoPos + movimiento, SERVO_MIN, SERVO_MAX);

    if (abs(movimiento) >= 1) {
        servoPos = nuevaPosicion;
        servoAzimut.write(servoPos);
        servoPosBIS = servoPos;
    }
}

// =============================================
// MODO LDR BÃSICO
// =============================================
void seguirModoLDRHybrid() {
    const int UMBRAL_MIN    = 100;
    const int UMBRAL_NORMAL = 500;
    const int UMBRAL_RAPIDO = 1000;
    int paso = 0;
    String tipoMovimiento;

    int diferenciaAbs = abs(diferenciaLdr);

    if (diferenciaAbs > UMBRAL_MIN) {
        if (diferenciaAbs <= UMBRAL_NORMAL)      { paso = 2;  tipoMovimiento = "FINO"; }
        else if (diferenciaAbs <= UMBRAL_RAPIDO) { paso = 25; tipoMovimiento = "NORMAL"; }
        else                                     { paso = 45; tipoMovimiento = "RÃPIDO"; }
    }

    int direccion = (diferenciaLdr > 0) ? -paso : paso;
    int nuevaPosicion = constrain(servoPos + direccion, SERVO_MIN, SERVO_MAX);

    if (nuevaPosicion != servoPos) {
        servoPos = nuevaPosicion;
        servoAzimut.write(servoPos);
        servoPosBIS = servoPos;

        Serial.print("ð¯ LDR Hybrid - "); Serial.print(tipoMovimiento);
        Serial.print(" | Dif: "); Serial.print(diferenciaLdr);
        Serial.print(" | Paso: "); Serial.print(paso);
        Serial.print(" | Pos: ");  Serial.println(servoPos);
    }
}

// =============================================
// ALGORITMOS ASTRONÃMICOS
// =============================================
double calcularDiaJuliano(int anio, int mes, int dia, int hora, int minuto, int segundo) {
    if (mes <= 2) { anio--; mes += 12; }
    int A = anio / 100;
    int B = 2 - A + (A / 4);
    double jd = floor(365.25 * (anio + 4716)) + floor(30.6001 * (mes + 1)) + dia + B - 1524.5;
    jd += (hora + minuto / 60.0 + segundo / 3600.0) / 24.0;
    return jd;
}

double calcularTiempoSidereoLocal(double JD, double longitud) {
    double T = (JD - 2451545.0) / 36525.0;
    double theta_G = 280.46061837 + 360.98564736629 * (JD - 2451545.0)
                   + 0.000387933 * T * T - T * T * T / 38710000.0;
    theta_G = fmod(theta_G, 360.0);
    if (theta_G < 0) theta_G += 360.0;
    double theta = fmod(theta_G + longitud, 360.0);
    if (theta < 0) theta += 360.0;
    return theta;
}

void calcularPosicionSolar(time_t tiempoUnix, double &elevacion, double &azimut, double &anguloHorario) {
    struct tm *t = localtime(&tiempoUnix);
    double JD = calcularDiaJuliano(t->tm_year + 1900, t->tm_mon + 1, t->tm_mday,
                                   t->tm_hour, t->tm_min, t->tm_sec);
    double n = JD - 2451545.0;
    double L = fmod(280.460 + 0.9856474 * n, 360.0);
    double g = fmod(357.528 + 0.9856003 * n, 360.0);
    double g_rad = g * DEG_TO_RAD;
    double lambda = L + 1.915 * sin(g_rad) + 0.020 * sin(2 * g_rad);
    double lambda_rad = lambda * DEG_TO_RAD;
    double epsilon = 23.439 - 0.0000004 * n;
    double epsilon_rad = epsilon * DEG_TO_RAD;
    double alpha = atan2(cos(epsilon_rad) * sin(lambda_rad), cos(lambda_rad));
    double delta = asin(sin(epsilon_rad) * sin(lambda_rad));

    double theta = calcularTiempoSidereoLocal(JD, LONGITUD);
    double H = theta - (alpha * RAD_TO_DEG);
    H = fmod(H + 180.0, 360.0) - 180.0;
    anguloHorario = H;

    double H_rad = H * DEG_TO_RAD;
    double lat_rad = LATITUD * DEG_TO_RAD;
    double elevacion_rad = asin(sin(lat_rad) * sin(delta) + cos(lat_rad) * cos(delta) * cos(H_rad));
    elevacion = elevacion_rad * RAD_TO_DEG;

    double azimut_rad = atan2(sin(H_rad), cos(H_rad) * sin(lat_rad) - tan(delta) * cos(lat_rad));
    azimut = fmod(azimut_rad * RAD_TO_DEG + 180.0, 360.0);
}

// =============================================
// MODO ASTRONÃMICO
// =============================================
void seguirModoAstronomico() {
    time_t tiempoActual = horaCloud;
    double elevacionSolar, azimutSolar, anguloHorario;
    calcularPosicionSolar(tiempoActual, elevacionSolar, azimutSolar, anguloHorario);

    double H_limit = constrain(anguloHorario, -90.0, 90.0);
    int nuevoAzimut = map((long)H_limit, -90L, 90L, SERVO_MIN, SERVO_MAX);
    nuevoAzimut = constrain(nuevoAzimut, SERVO_MIN, SERVO_MAX);

    if (nuevoAzimut != servoPos) {
        servoPos = nuevoAzimut;
        servoAzimut.write(servoPos);
    }
}

// =============================================
// FUNCIONES METEOROLÃGICAS
// =============================================
bool obtenerDatosMeteorologicos() {
    HTTPClient http;
    http.begin(OPENWEATHER_URL);
    http.setTimeout(10000);
    http.addHeader("Content-Type", "application/json");
    http.addHeader("User-Agent", "ESP32-Solar-Tracker");

    int httpCode = http.GET();

    if (httpCode == HTTP_CODE_OK) {
        String payload = http.getString();
        DynamicJsonDocument doc(2048);
        DeserializationError error = deserializeJson(doc, payload);

        if (error) {
            datosClima.error = true;
            datosClima.mensaje_error = "Error JSON: " + String(error.c_str());
            http.end();
            return false;
        }

        datosClima.temperatura        = doc["main"]["temp"];
        datosClima.humedad            = doc["main"]["humidity"];
        datosClima.presion            = doc["main"]["pressure"];
        datosClima.velocidad_viento   = doc["wind"]["speed"];
        datosClima.direccion_viento   = doc["wind"]["deg"];
        datosClima.nubosidad          = doc["clouds"]["all"];

        const char* condicion = doc["weather"][0]["description"];
        datosClima.condicion = String(condicion);

        unsigned long timestamp = doc["dt"];
        time_t tiempo = timestamp;
        struct tm *tm_info = localtime(&tiempo);
        char buffer[20];
        strftime(buffer, 20, "%H:%M:%S %d/%m", tm_info);
        datosClima.actualizacion = String(buffer);

        datosClima.error = false;
        datosClima.mensaje_error = "";
        http.end();
        return true;
    } else {
        datosClima.error = true;
        datosClima.mensaje_error = "HTTP Error: " + String(httpCode);
        http.end();
        return false;
    }
}


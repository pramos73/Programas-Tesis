// =============================================
// CONTROLADOR PI
// =============================================
class ControladorPI {
private:
    double errorAnterior;
    double integral;
    double errorFiltrado;

public:
    const double KP = 1.2;
    const double KI = 0.08;
    const double MAX_INTEGRAL = 50.0;
    const double ZONA_MUERTA  = 25.0;
    const double ALFA_FILTRO  = 0.8;

    ControladorPI() : errorAnterior(0), integral(0), errorFiltrado(0) {}

    double calcularSalida(double error) {
        if (fabs(error) < ZONA_MUERTA) error = 0.0;

        errorFiltrado = ALFA_FILTRO * errorFiltrado + (1.0 - ALFA_FILTRO) * error;

        integral += errorFiltrado;
        if (integral >  MAX_INTEGRAL) integral =  MAX_INTEGRAL;
        if (integral < -MAX_INTEGRAL) integral = -MAX_INTEGRAL;

        double salida = KP * errorFiltrado + KI * MUESTREO_T * integral;
        errorAnterior = errorFiltrado;
        return salida;
    }

    void reset() {
        errorAnterior = 0;
        integral = 0;
        errorFiltrado = 0;
    }

    void mostrarEstado() {
        Serial.print("PI_ErrorFiltrado:"); Serial.print(errorFiltrado);
        Serial.print("|PI_Integral:");     Serial.print(integral);
        Serial.print("|PI_Salida:");       Serial.print(KP * errorFiltrado + KI * MUESTREO_T * integral);
    }
};
ControladorPI controladorPI;


// =============================================
// GOOGLE SHEETS
// =============================================
bool enviarDatosGoogleSheets() {
    Serial.println("\nð¤ === ENVIANDO A GOOGLE SHEETS ===");

    if (WiFi.status() != WL_CONNECTED) {
        Serial.println("â WiFi no conectado");
        return false;
    }

    HTTPClient http;
    http.setTimeout(5000);
    http.setReuse(true);

    if (!http.begin(GOOGLE_SCRIPT_URL)) {
        Serial.println("â Error iniciando HTTP");
        return false;
    }
    http.addHeader("Content-Type", "application/json");

    DynamicJsonDocument jsonDoc(3072);

    struct tm timeinfo;
    time_t tiempoActual = horaCloud;
    gmtime_r(&tiempoActual, &timeinfo);
    char fechaStr[11], horaStr[9];
    strftime(fechaStr, sizeof(fechaStr), "%d/%m/%Y", &timeinfo);
    strftime(horaStr, sizeof(horaStr), "%H:%M:%S", &timeinfo);

    jsonDoc["modo_seguimiento"] = modoSeguimiento;
    jsonDoc["azimut_servo"]     = servoPosBIS;

    double elevacionSolar, azimutSolar, anguloHorario;
    calcularPosicionSolar(horaCloud, elevacionSolar, azimutSolar, anguloHorario);
    jsonDoc["azimut_solar"] = round(azimutSolar * 10) / 10.0;

    jsonDoc["ldr_este"]  = valorLdrEsteBIS;
    jsonDoc["ldr_oeste"] = valorLdrOesteBIS;

    jsonDoc["voltaje1G_V"]     = voltaje_1Bis;
    jsonDoc["corriente1G_A"]   = corriente_1Bis;
    jsonDoc["potencia1G_W"]    = potencia_1Bis;

    jsonDoc["voltaje2FIJO_V"]  = voltaje_2Bis;
    jsonDoc["corriente2FIJO_A"]= corriente_2Bis;
    jsonDoc["potencia2FIJO_W"] = potencia_2Bis;

    jsonDoc["voltaje3FIJOA_V"] = voltaje_3Bis;
    jsonDoc["corriente3FIJOA_A"]= corriente_3Bis;
    jsonDoc["potencia3FIJOA_W"]= potencia_3Bis;

    jsonDoc["voltaje3FIJOB_V"] = voltaje_4Bis;
    jsonDoc["corriente3FIJOB_A"]= corriente_4Bis;
    jsonDoc["potencia3FIJOB_W"]= potencia_4Bis;

    // MeteorologÃ­a
    actualizarCloudMeteorologico();
    if (!datosClima.error) {
        calcularCalidadAire();
        jsonDoc["temperatura_externa"]   = datosClima.temperatura;
        jsonDoc["humedad_externa"]       = datosClima.humedad;
        jsonDoc["presion_atmosferica_hPa"]= datosClima.presion;
        jsonDoc["velocidad_viento"]      = datosClima.velocidad_viento;
        jsonDoc["direccion_viento"]      = datosClima.direccion_viento;
        jsonDoc["condicion_clima"]       = datosClima.condicion;
        jsonDoc["nubosidad"]             = datosClima.nubosidad;
        jsonDoc["calidad_aire"]          = datosClima.calidad_aire;
    } else {
        jsonDoc["temperatura_externa"]   = 0.0;
        jsonDoc["humedad_externa"]       = 0.0;
        jsonDoc["presion_atmosferica_hPa"]= 0.0;
        jsonDoc["velocidad_viento"]      = 0.0;
        jsonDoc["direccion_viento"]      = 0.0;
        jsonDoc["condicion_clima"]       = "No disponible";
        jsonDoc["nubosidad"]             = 0.0;
        jsonDoc["calidad_aire"]          = 0.0;
    }

    jsonDoc["fecha"] = fechaStr;
    jsonDoc["hora"]  = horaStr;
    jsonDoc["ip_dispositivo"] = WiFi.localIP().toString();
    jsonDoc["rssi_wifi"]      = WiFi.RSSI();

    String jsonString;
    size_t jsonSize = serializeJson(jsonDoc, jsonString);
    Serial.print("ð¦ JSON: "); Serial.print(jsonSize); Serial.println(" bytes");

    int httpCode = http.POST(jsonString);
    Serial.print("ð® HTTP: "); Serial.println(httpCode);

    http.end();
    return (httpCode > 0);
}


// =============================================
// LOOP PRINCIPAL
// =============================================
void loop() {
    ArduinoCloud.update();

    if (ArduinoCloud.connected()) {
        horaCloud = ArduinoCloud.getLocalTime();
        unsigned long ahora = millis();

        // === BLOQUE RÃPIDO (~200 ms): LDR + seguimiento ===
        leerSensoresLDR();
        ejecutarSeguimiento();

        // === LECTURA CONTINUA INA219 (sin relÃ©s) ===
        leerSensoresINA219();

        // === ENVÃO A GOOGLE SHEETS cada 15 s ===
        if (ahora - ultimoEnvioSheets >= INTERVALO_ENVIO) {
            enviarDatosGoogleSheets();
            ultimoEnvioSheets = ahora;
        }

        // === DISPLAY cada 30 s ===
        if (ahora - ultimoDisplay >= INTERVALO_DISPLAY) {
            mostrarInformacionSistema();
            ultimoDisplay = ahora;
        }

        // === OPENWEATHER cada 10 min ===
        bool debeActualizar = primeraActualizacion ||
                              (ahora - ultimaLecturaMeteo >= INTERVALO_METEO);
        if (debeActualizar) {
            Serial.println("ð Actualizando datos meteorolÃ³gicos...");
            if (obtenerDatosMeteorologicos()) {
                actualizarCloudMeteorologico();
                datosClima.calidad_aire = calcularCalidadAire();
                calidadAire = datosClima.calidad_aire;
                mostrarDatosMeteorologicos();

                ultimaLecturaMeteo = ahora;
                primeraActualizacion = false;
                Serial.println("â Datos meteorolÃ³gicos actualizados en Cloud");
            } else {
                Serial.println("â FallÃ³ actualizaciÃ³n meteorolÃ³gica");
                if (primeraActualizacion) {
                    ultimaLecturaMeteo = ahora - (INTERVALO_METEO - 60000);
                }
            }
        }
    } else {
        Serial.println("â³ Esperando conexiÃ³n Arduino Cloud...");
    }

    delay(200);
}


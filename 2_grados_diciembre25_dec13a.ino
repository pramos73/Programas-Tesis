// =============================================
// SETUP / LOOP
// =============================================
void setup() {
    Serial.begin(9600);
    initProperties();
    ArduinoCloud.begin(ArduinoIoTPreferredConnection);
    setDebugMessageLevel(2);
    ArduinoCloud.printDebugInfo();

    if (WiFi.status() == WL_CONNECTED) {
        Serial.println("Mi IP: " + WiFi.localIP().toString());
    }

    inicializarSensores();
    ubicacionProyecto = Location(LATITUD, LONGITUD);

    Serial.println("â Sistema inicializado");
    delay(500);
}

void loop() {
    ArduinoCloud.update();

    if (ArduinoCloud.connected()) {
        horaCloud = ArduinoCloud.getLocalTime();
        unsigned long ahora = millis();

        // === BLOQUE RÃPIDO (~200 ms): LDR + seguimiento PI/LDR ===
        leerSensoresLDR();
        ejecutarSeguimientoRapido();

        // === BLOQUE LENTO (45 s): I2C + astronÃ³mico + envÃ­o + display ===
        if (ahora - ultimoEnvio >= intervaloEnvio) {
            leerSensoresI2C();        // INA219 + SHT31 + BH1750
            ejecutarSeguimientoLento(); // Solo AstronÃ³mico
            enviarDatosGoogleSheets();
            mostrarInformacionSistema();
            ultimoEnvio = ahora;
        }
    } else {
        Serial.println("â³ Esperando conexiÃ³n con Arduino Cloud...");
    }

    delay(200);
}


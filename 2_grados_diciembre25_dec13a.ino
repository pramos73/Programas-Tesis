// GOOGLE SHEETS
// =============================================
bool enviarDatosGoogleSheets() {
    Serial.println("\nð¤ === ENVIANDO A GOOGLE SHEETS ===");
    if (WiFi.status() != WL_CONNECTED) {
        Serial.println("â WiFi no conectado");
        return false;
    }

    HTTPClient http;
    http.setTimeout(5000);
    http.setReuse(true);

    if (!http.begin(GOOGLE_SCRIPT_URL)) {
        Serial.println("â Error iniciando HTTP");
        return false;
    }
    http.addHeader("Content-Type", "application/json");

    DynamicJsonDocument jsonDoc(2048);

    struct tm timeinfo;
    time_t tiempoActual = horaCloud;
    gmtime_r(&tiempoActual, &timeinfo);
    char fechaStr[11], horaStr[9];
    strftime(fechaStr, sizeof(fechaStr), "%d/%m/%Y", &timeinfo);
    strftime(horaStr, sizeof(horaStr), "%H:%M:%S", &timeinfo);

    jsonDoc["modo_seguimiento"] = modoSeguimiento;
    jsonDoc["elevacion_servo"]  = posElevacion;
    jsonDoc["azimut_servo"]     = posAzimut;

    jsonDoc["temp_local"] = round(temperatura_local * 10) / 10.0;
    jsonDoc["hum_local"]  = round(humedad_local * 10) / 10.0;
    jsonDoc["luz_local"]     = luzAmbiental_local;
    jsonDoc["voltaje_5v"]    = voltaje_5;
    jsonDoc["corriente_5v"]  = corriente_5;
    jsonDoc["potencia_5v"]   = potencia_5;

    jsonDoc["ldr_norte"] = valorLdrNorte;
    jsonDoc["ldr_sur"]   = valorLdrSur;
    jsonDoc["ldr_este"]  = valorLdrEste;
    jsonDoc["ldr_oeste"] = valorLdrOeste;

    if (ArduinoCloud.connected()) {
        double elevacionSolar, azimutSolar, anguloHorario, declinacion;
        calcularPosicionSolar(tiempoActual, elevacionSolar, azimutSolar, anguloHorario, declinacion);
        jsonDoc["elevacion_solar"] = round(elevacionSolar * 10.0) / 10.0;
        jsonDoc["azimut_solar"]    = round(azimutSolar   * 10.0) / 10.0;
        jsonDoc["fecha"] = fechaStr;
        jsonDoc["hora"]  = horaStr;
    } else {
        jsonDoc["elevacion_solar"] = 0;
        jsonDoc["azimut_solar"]    = 0;
        jsonDoc["fecha"] = "N/A";
        jsonDoc["hora"]  = "N/A";
    }

    jsonDoc["ip_dispositivo"] = WiFi.localIP().toString();
    jsonDoc["rssi_wifi"]      = WiFi.RSSI();

    String jsonString;
    size_t jsonSize = serializeJson(jsonDoc, jsonString);
    Serial.print("ð¦ JSON: "); Serial.print(jsonSize); Serial.println(" bytes");

    int httpCode = http.POST(jsonString);
    Serial.print("ð® CÃ³digo HTTP: "); Serial.println(httpCode);
    http.end();
    return (httpCode > 0);
}


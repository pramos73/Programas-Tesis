void leerSensoresLDR() {
    valorLdrNorte = analogRead(LDR_NORTE);
    valorLdrSur   = analogRead(LDR_SUR);
    valorLdrEste  = analogRead(LDR_ESTE);
    valorLdrOeste = analogRead(LDR_OESTE);

    valorLdrNorteCloud = valorLdrNorte;
    valorLdrSurCloud   = valorLdrSur;
    valorLdrEsteCloud  = valorLdrEste;
    valorLdrOesteCloud = valorLdrOeste;

    diferenciaNS = valorLdrNorte - valorLdrSur;
    diferenciaEO = valorLdrEste  - valorLdrOeste;

    diferenciaNSCloud = diferenciaNS;
    diferenciaEOCloud = diferenciaEO;
}

// Lectura INA219 
void leerINA219() {
    float vshunt = ina219_5.getShuntVoltage_mV();
    float bus    = ina219_5.getBusVoltage_V();

    // Voltaje = bus + caÃ­da shunt
    voltaje_5    = bus + (vshunt / 1000.0);
    corriente_5  = ina219_5.getCurrent_mA() / 1000.0;
    potencia_5   = voltaje_5 * corriente_5;

    voltajeCloud   = voltaje_5;
    corrienteCloud = corriente_5;
    potenciaCloud  = potencia_5;
}

void leerSensoresI2C() {
    leerINA219();

    float t = sht31.readTemperature();
    float h = sht31.readHumidity();
    if (!isnan(t)) temperatura_local = t;
    if (!isnan(h)) humedad_local     = h;

    if (lightMeter.measurementReady()) {
        luzAmbiental_local = (int)lightMeter.readLightLevel();
    }

    temperaturaCloud   = temperatura_local;
    humedadCloud       = humedad_local;
    luzAmbientalCloud  = luzAmbiental_local;
}

// =============================================
// ALGORITMOS ASTRONÃMICOS
// =============================================
double calcularDiaJuliano(int anio, int mes, int dia, int hora, int minuto, int segundo) {
    if (mes <= 2) { anio--; mes += 12; }
    int A = anio / 100;
    int B = 2 - A + (A / 4);
    double jd = floor(365.25 * (anio + 4716)) + floor(30.6001 * (mes + 1)) + dia + B - 1524.5;
    jd += (hora + minuto / 60.0 + segundo / 3600.0) / 24.0;
    return jd;
}

double calcularTiempoSidereoLocal(double JD, double longitud) {
    double T = (JD - 2451545.0) / 36525.0;
    double theta_G = 280.46061837 + 360.98564736629 * (JD - 2451545.0)
                   + 0.000387933 * T * T - T * T * T / 38710000.0;
    theta_G = fmod(theta_G, 360.0);
    if (theta_G < 0) theta_G += 360.0;
    double theta = fmod(theta_G + longitud, 360.0);
    if (theta < 0) theta += 360.0;
    return theta;
}

void calcularPosicionSolar(time_t tiempoUnix, double &elevacion, double &azimut,
                           double &anguloHorario, double &declinacion) {
    struct tm *t = localtime(&tiempoUnix);
    double JD = calcularDiaJuliano(t->tm_year + 1900, t->tm_mon + 1, t->tm_mday,
                                   t->tm_hour, t->tm_min, t->tm_sec);
    double n = JD - 2451545.0;
    double L = fmod(280.460 + 0.9856474 * n, 360.0);
    double g = fmod(357.528 + 0.9856003 * n, 360.0);
    double g_rad = g * DEG_TO_RAD;
    double lambda = L + 1.915 * sin(g_rad) + 0.020 * sin(2 * g_rad);
    double lambda_rad = lambda * DEG_TO_RAD;
    double epsilon = 23.439 - 0.0000004 * n;
    double epsilon_rad = epsilon * DEG_TO_RAD;
    double alpha = atan2(cos(epsilon_rad) * sin(lambda_rad), cos(lambda_rad));
    double delta = asin(sin(epsilon_rad) * sin(lambda_rad));
    declinacion = delta * RAD_TO_DEG;

    double theta = calcularTiempoSidereoLocal(JD, LONGITUD);
    double H = theta - (alpha * RAD_TO_DEG);
    H = fmod(H + 180.0, 360.0) - 180.0;
    anguloHorario = H;

    double H_rad = H * DEG_TO_RAD;
    double lat_rad = LATITUD * DEG_TO_RAD;
    double elevacion_rad = asin(sin(lat_rad) * sin(delta) + cos(lat_rad) * cos(delta) * cos(H_rad));
    elevacion = elevacion_rad * RAD_TO_DEG;

    double azimut_rad = atan2(sin(H_rad), cos(H_rad) * sin(lat_rad) - tan(delta) * cos(lat_rad));
    azimut = fmod(azimut_rad * RAD_TO_DEG + 180.0, 360.0);
}

// =============================================
// MODOS DE SEGUIMIENTO
// =============================================
void seguirModoAstronomico() {
    time_t tiempoActual = horaCloud;
    double elevacionSolar, azimutSolar, anguloHorario, declinacion;
    calcularPosicionSolar(tiempoActual, elevacionSolar, azimutSolar, anguloHorario, declinacion);

    double H_limit = constrain(anguloHorario, -90.0, 90.0);
    int nuevoAzimut = map((long)H_limit, -90L, 90L, SERVO_MIN, SERVO_MAX);
    nuevoAzimut = constrain(nuevoAzimut, SERVO_MIN, SERVO_MAX);

    int nuevaElevacion = constrain((int)elevacionSolar, SERVO_MIN, SERVO_MID);

    if (nuevaElevacion != posElevacion) { posElevacion = nuevaElevacion; servoElevacion.write(posElevacion); }
    if (nuevoAzimut    != posAzimut)    { posAzimut    = nuevoAzimut;    servoAzimut.write(posAzimut); }

    azimutSolarCloud    = posAzimut;
    elevacionSolarCloud = posElevacion;
}

int calcularPasoLDR(int diferencia) {
    int d = abs(diferencia);
    int paso = 0;
    if (d >= UMBRAL_RAPIDO)      paso = PASO_RAPIDO;
    else if (d >= UMBRAL_NORMAL) paso = PASO_NORMAL;
    else if (d >= UMBRAL_MIN)    paso = PASO_LENTO;
    else                         paso = PASO_NULO;
    return (diferencia < 0) ? -paso : paso;
}

String obtenerTipoMovimiento(int paso) {
    int p = abs(paso);
    if (p == PASO_RAPIDO) return "RÃPIDO";
    if (p == PASO_NORMAL) return "NORMAL";
    if (p == PASO_LENTO)  return "LENTO";
    return "QUIETO";
}

double controlPI(double error, double &integral, double &errorAnterior) {
    if (fabs(error) < ZONA_MUERTA) error = 0.0;
    integral += error;
    if (integral >  MAX_INTEGRAL) integral =  MAX_INTEGRAL;
    if (integral < -MAX_INTEGRAL) integral = -MAX_INTEGRAL;
    double salida = KP * error + KI * MUESTREO_T * integral;
    errorAnterior = error;
    return salida;
}

void seguirModoPI() {
    double salidaNS = controlPI(diferenciaNS, integralNS, errorAnteriorNS);
    double salidaEO = controlPI(diferenciaEO, integralEO, errorAnteriorEO);

    int movNS = (int)constrain(salidaNS, -10, 10);
    int movEO = (int)constrain(salidaEO, -10, 10);

    if (abs(movNS) >= 1) {
        posElevacion = constrain(posElevacion + movNS, SERVO_MIN, SERVO_MAX);
        servoElevacion.write(posElevacion);
    }
    if (abs(movEO) >= 1) {
        posAzimut = constrain(posAzimut + movEO, SERVO_MIN, SERVO_MAX);
        servoAzimut.write(posAzimut);
    }
    azimutSolarCloud    = posAzimut;
    elevacionSolarCloud = posElevacion;
}

void seguirModoLDRHybrid() {
    int pasoNS = calcularPasoLDR(diferenciaNS);
    int pasoEO = calcularPasoLDR(diferenciaEO);

    posElevacion = constrain(posElevacion + pasoNS, SERVO_MIN, SERVO_MAX);
    servoElevacion.write(posElevacion);

    posAzimut = constrain(posAzimut + pasoEO, SERVO_MIN, SERVO_MAX);
    servoAzimut.write(posAzimut);

    azimutSolarCloud    = posAzimut;
    elevacionSolarCloud = posElevacion;
}

// Seguimiento rÃ¡pido (LDR / PI) - llamado desde el bloque de ~200 ms
void ejecutarSeguimientoRapido() {
    switch (modoSeguimiento) {
        case 0: /* AstronÃ³mico: no corre en bloque rÃ¡pido */ break;
        case 1: seguirModoPI();          break;
        case 2:
        default: seguirModoLDRHybrid(); break;
    }
}

// Seguimiento lento (AstronÃ³mico) - llamado desde el bloque de 45 s
void ejecutarSeguimientoLento() {
    if (modoSeguimiento == 0) {
        seguirModoAstronomico();
    }
}

